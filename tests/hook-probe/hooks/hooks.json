{
  "description": "hook-probe",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/probe.js\" v1-cmd SessionStart",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/probe.js",
              "v2-args",
              "SessionStart"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/probe v3-sh SessionStart",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/probe.js\" v4-fallback SessionStart",
            "powershell": "node \"${CLAUDE_PLUGIN_ROOT}/probe.js\" v4-ps SessionStart",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/probe.cmd\" v5-cmdfile SessionStart",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/probe.js\" v6-async SessionStart",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/probe.js\" v7-matcher SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
