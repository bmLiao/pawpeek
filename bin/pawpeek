#!/bin/sh
# PawPeek 啟動器：repo 的 bin/ 同時放 Windows 與 macOS 執行檔，依作業系統轉交給對應的版本。
# hooks.json 與 commands/*.md 都呼叫這支，讓插件可以直接從 GitHub 安裝、不用自己編譯。
DIR=$(cd "$(dirname "$0")" && pwd)
case "$(uname -s)" in
  Darwin) exec "$DIR/pawpeek-macos" "$@" ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) exec "$DIR/pawpeek.exe" "$@" ;;
  *)
    # hook 模式一律正常結束：Copilot 的 PreToolUse hook 失敗會擋下工具呼叫
    case "$1" in --hook) cat >/dev/null; exit 0 ;; esac
    echo "pawpeek: 不支援的作業系統 $(uname -s)" >&2; exit 1 ;;
esac
