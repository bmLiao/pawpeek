{
  "description": "PawPeek - 桌寵精靈 hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|new",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 10,
            "statusMessage": "桌寵小精靈上線中..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "ErrorOccurred": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek\" --hook",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}/bin/pawpeek.exe\" --hook",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
